# Used by the full-stack compose.yaml. Never commit real credentials.
GOOGLE_API_KEY=replace_with_your_google_ai_studio_key

# Local demo settings. Choose a URL-safe password (letters, digits, underscores).
POSTGRES_PASSWORD=local_demo_password
WEB_PORT=5173

# Approximate conversation context threshold and number of recent complete turns.
CONTEXT_TOKEN_LIMIT=6000
CONTEXT_RECENT_TURNS=6
