# Copiá este archivo a .env y completá tu clave de Gemini.
GOOGLE_API_KEY=tu_clave_de_google_ai_studio

# Servidor MCP de consultas del negocio
MCP_SERVER_URL=http://127.0.0.1:8001/mcp
MCP_TIMEOUT_SECONDS=15

# API Express: solo se usa directamente para las propuestas y cambios aprobados
BUSINESS_API_URL=http://127.0.0.1:3001
API_TIMEOUT_SECONDS=10

# Contexto: umbral aproximado de tokens y últimos turnos completos
CONTEXT_TOKEN_LIMIT=6000
CONTEXT_RECENT_TURNS=6
